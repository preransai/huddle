# Copy this file to server/.env and adjust as needed.
# Every value is optional in development.

# Port for the API (and for the built client when it is served by Express)
PORT=5000

# Leave empty to run against an in-memory MongoDB that is seeded on start.
# Local:  mongodb://127.0.0.1:27017/huddle
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/huddle
MONGODB_URI=

# Required in production. Any long random string works, e.g. the output of
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed by CORS and Socket.IO when the client runs on a different origin
CLIENT_URL=http://localhost:5173

# Where uploaded images are written (defaults to server/uploads)
UPLOAD_DIR=

# Set to production when deploying: enables secure cookies and requires
# MONGODB_URI and JWT_SECRET
NODE_ENV=development
