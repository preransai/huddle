# Only read by the Vite dev server (vite.config.js), not shipped to the browser.

# Port for the dev server
CLIENT_PORT=5173

# Where /api, /uploads and /socket.io are proxied in development.
# Leave it unset to follow the API's PORT (http://localhost:$PORT, or 5000).
# Setting it here overrides PORT for the proxy.
# API_PROXY_TARGET=http://localhost:5000
